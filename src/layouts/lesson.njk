---
layout: base.njk
---
<article class="lesson" data-lesson="{{ lessonId }}"><header class="lesson-head"><p class="eyebrow">{{ chapterId }} · {{ chapterTitle }} <span> / </span> {{ level }}</p><h1>{{ lessonId }} — {{ title }}</h1><p class="dek">{{ subtitle }}</p><div class="meta"><span>Study time: {{ minutes }} min</span><span>Focus: {{ focus }}</span></div><button class="complete-button" data-complete="{{ lessonId }}">Mark lesson complete</button></header>{{ content | safe }}<nav class="lesson-nav" aria-label="Lesson navigation">{% if previous %}<a href="{{ ('/lessons/' + previous + '/') | url }}">← Previous lesson</a>{% endif %}{% if next %}<a href="{{ ('/lessons/' + next + '/') | url }}">Next lesson →</a>{% endif %}</nav></article>
