<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ title }} · Deutsch Masterclass</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="stylesheet" href="{{ '/assets/css/main.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/css/print.css' | url }}" media="print">
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="topbar"><a class="brand" href="{{ '/' | url }}">Deutsch <span>Masterclass</span></a><button class="menu-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button><nav id="site-nav" aria-label="Main navigation"><a href="{{ '/' | url }}">Course</a><a href="{{ '/chapters/' | url }}">Chapters</a><a href="{{ '/references/' | url }}">References</a><a href="{{ '/assessments/' | url }}">Assessments</a><a href="{{ '/print/' | url }}">Print edition</a><a href="{{ '/mistakes/' | url }}">Meine Fehler</a></nav></header>
<div class="shell"><aside class="sidebar" aria-label="Course outline"><p class="eyebrow">COURSE OUTLINE</p>{% for chapter in chapters %}<details {% if chapter.number == activeChapter %}open{% endif %}><summary>{{ chapter.id }} · {{ chapter.title }}</summary><ul>{% for lesson in chapter.lessons %}<li>{% if lesson.id == "L01" or lesson.id == "L02" or lesson.id == "L03" or lesson.id == "L27" %}<a href="{{ ('/lessons/' + lesson.id + '/') | url }}">{{ lesson.id }} {{ lesson.title }}</a>{% else %}<span class="nav-pending">{{ lesson.id }} {{ lesson.title }}</span>{% endif %}</li>{% endfor %}</ul></details>{% endfor %}<div class="side-links"><a href="{{ '/references/' | url }}">Grammar & word libraries</a><a href="{{ '/assessments/' | url }}">Assessments</a></div></aside><main id="main">{{ content | safe }}</main></div>
<footer><span>Deutsch Masterclass · Original learning material</span><span>Progress is saved in this browser. Export it to move devices.</span></footer>
<script src="{{ '/assets/js/app.js' | url }}" defer></script><script src="{{ '/assets/js/progress.js' | url }}" defer></script>
</body></html>
